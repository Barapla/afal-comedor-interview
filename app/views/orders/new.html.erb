<% content_for :title, "Nuevo pedido" %>

<h1>Pedido del día — <%= l(@daily_menu.menu_date, format: :long) %></h1>

<%= form_with url: orders_path do |f| %>
  <div class="card">
    <h2>Tu comida</h2>
    <p class="muted">Selecciona los platillos que vas a consumir hoy.</p>

    <table>
      <thead>
        <tr>
          <th></th>
          <th>Platillo</th>
          <th>Precio</th>
          <th>Stock</th>
        </tr>
      </thead>
      <tbody>
        <% @menu_items.each do |menu_item| %>
          <tr>
            <td>
              <%= check_box_tag "menu_item_ids[]", menu_item.id, false, id: "menu_item_#{menu_item.id}" %>
            </td>
            <td><%= label_tag "menu_item_#{menu_item.id}", menu_item.dish.name %></td>
            <td>$<%= "%.2f" % menu_item.dish.price %></td>
            <td><%= menu_item.stock %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="muted">Marca los platillos que deseas incluir en tu pedido.</p>
  </div>

  <div class="card">
    <h2>Invitados (opcional)</h2>
    <p class="muted">Agrega los comensales externos que te acompañarán. Cada invitado selecciona sus propios platillos. El subsidio solo aplica a tu consumo.</p>

    <div id="guests-container"></div>

    <button type="button" id="add-guest-btn" class="button secondary">+ Agregar invitado</button>
  </div>

  <div class="actions">
    <%= f.submit "Confirmar pedido" %>
    <%= link_to "Cancelar", orders_path, class: "button secondary" %>
  </div>
<% end %>

<script>
  (function () {
    var menuItems = <%= @menu_items.map { |mi| { id: mi.id, name: mi.dish.name, price_cents: mi.price_cents } }.to_json.html_safe %>;
    var guestIndex = 0;
    var btn = document.getElementById('add-guest-btn');
    var container = document.getElementById('guests-container');

    btn.addEventListener('click', function () {
      var idx = guestIndex++;
      var entry = document.createElement('div');
      entry.className = 'guest-entry';
      entry.style.cssText = 'margin-top:1rem; padding:1rem; border:1px solid #ddd; border-radius:4px;';

      var dishRows = menuItems.map(function (item) {
        return '<tr>' +
          '<td><input type="checkbox" name="guests[' + idx + '][menu_item_ids][]" value="' + item.id + '"></td>' +
          '<td>' + item.name + '</td>' +
          '<td>$' + (item.price_cents / 100).toFixed(2) + '</td>' +
          '</tr>';
      }).join('');

      entry.innerHTML =
        '<div>' +
          '<label>Nombre del invitado <span style="color:red">*</span></label>' +
          '<input type="text" name="guests[' + idx + '][name]" placeholder="Nombre completo" style="width:100%" />' +
        '</div>' +
        '<div style="margin-top:0.5rem">' +
          '<label>Nota (opcional)</label>' +
          '<textarea name="guests[' + idx + '][note]" placeholder="Ej: alérgico a nueces" rows="2" style="width:100%"></textarea>' +
        '</div>' +
        '<div style="margin-top:0.5rem">' +
          '<label>Platillos para este invitado <span style="color:red">*</span></label>' +
          '<table><thead><tr><th></th><th>Platillo</th><th>Precio</th></tr></thead>' +
          '<tbody>' + dishRows + '</tbody></table>' +
        '</div>' +
        '<button type="button" class="remove-guest button secondary" style="margin-top:0.5rem">Quitar invitado</button>';

      entry.querySelector('.remove-guest').addEventListener('click', function () {
        this.closest('.guest-entry').remove();
      });

      container.appendChild(entry);
    });
  })();
</script>
