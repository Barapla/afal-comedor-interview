<% content_for :title, "Pedido ##{@order.id}" %>

<h1>Pedido del <%= l(@order.daily_menu.menu_date, format: :long) %></h1>

<div class="card">
  <p><strong>Estado:</strong> <%= @order.status %></p>

  <h3>Tu pedido</h3>
  <table>
    <thead>
      <tr><th>Platillo</th><th class="right">Precio</th></tr>
    </thead>
    <tbody>
      <% @order.order_items.each do |item| %>
        <tr>
          <td><%= item.menu_item.dish.name %></td>
          <td class="right">$<%= "%.2f" % (item.price_cents / 100.0) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th>Subtotal (tu comida)</th>
        <th class="right">$<%= "%.2f" % (@order.items_total_cents / 100.0) %></th>
      </tr>
      <tr>
        <th>Subsidio aplicado</th>
        <th class="right">-$<%= "%.2f" % (@order.subsidy_applied_cents / 100.0) %></th>
      </tr>
      <tr>
        <th>Tu costo neto</th>
        <th class="right">$<%= "%.2f" % (@order.amount_due_cents / 100.0) %></th>
      </tr>
      <% if @order.guests.any? %>
        <tr>
          <th>Costo invitados</th>
          <th class="right">$<%= "%.2f" % (@order.guests_total_cents / 100.0) %></th>
        </tr>
      <% end %>
      <tr>
        <th>Total a descontar de nómina</th>
        <th class="right">$<%= "%.2f" % (@order.total_payroll_deduction_cents / 100.0) %> MXN</th>
      </tr>
    </tfoot>
  </table>

  <% if @order.guests.any? %>
    <h3 style="margin-top:1.5rem">Invitados</h3>
    <% @order.guests.each do |guest| %>
      <div style="margin-top:1rem; padding:0.75rem; border:1px solid #eee; border-radius:4px;">
        <strong><%= guest.name %></strong>
        <% if guest.note.present? %>
          — <span class="muted"><%= guest.note %></span>
        <% end %>
        <% if guest.guest_order_items.any? %>
          <table style="margin-top:0.5rem">
            <thead>
              <tr><th>Platillo</th><th class="right">Precio</th></tr>
            </thead>
            <tbody>
              <% guest.guest_order_items.each do |goi| %>
                <tr>
                  <td><%= goi.menu_item.dish.name %></td>
                  <td class="right">$<%= "%.2f" % (goi.price_cents / 100.0) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr>
                <th>Subtotal invitado</th>
                <th class="right">$<%= "%.2f" % (guest.guest_order_items.sum(&:price_cents) / 100.0) %></th>
              </tr>
            </tfoot>
          </table>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<%= link_to "Volver", orders_path %>
